# Copy this file to .env and replace the placeholder secrets before starting the stack.
BACKEND_PORT=3000
FRONTEND_PORT=8080
ADMINER_PORT=8081
FRONTEND_ORIGINS=http://localhost:8080

POSTGRES_USER=fullstack_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=fullstack_db

JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

YANDEX_CLIENT_ID=replace-with-yandex-client-id
YANDEX_CLIENT_SECRET=replace-with-yandex-client-secret
YANDEX_REDIRECT_URI=http://localhost:3000/oauth/yandex/callback
VITE_AUTH_API_URL=http://localhost:3000
